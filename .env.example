# --- LLM (optional) ---------------------------------------------------------
# Without a key every agent runs in deterministic mode (fully offline, same pipeline).
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
USE_LLM=true

# --- Retrieval --------------------------------------------------------------
# hash = offline feature-hashing embeddings, gemini = text-embedding-004 (needs key)
EMBEDDING_BACKEND=hash
CHROMA_DIR=.chroma

# --- Self-correction loop ---------------------------------------------------
MAX_ITERATIONS=4
MIN_DSCR=1.25

# --- Langfuse tracing (optional) --------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
